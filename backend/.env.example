# Service URLs
WATER_ENGINE_URL=http://localhost:8001
HEAT_ENGINE_URL=http://localhost:8002
CONTINUITY_ENGINE_URL=http://localhost:8003
AGENTS_URL=http://localhost:8004
COLOCATION_ENGINE_URL=http://localhost:8000

# Database
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Security
CORS_ALLOWED_ORIGINS=*

# Timeouts
BRIDGE_WATER_TIMEOUT=300.0
BRIDGE_HEAT_TIMEOUT=300.0
BRIDGE_CONTINUITY_TIMEOUT=300.0
BRIDGE_REPORTER_TIMEOUT=30.0
BRIDGE_CRITIC_TIMEOUT=30.0
COPILOT_ENGINE_TIMEOUT=25
HEAT_CONTINUITY_TIMEOUT=60.0
WATER_CONTINUITY_TIMEOUT=60.0

# Performance
TORCH_NUM_THREADS=2

# Credentials
# Choose one of: GOOGLE_API_KEY, GOOGLE_APPLICATION_CREDENTIALS, ADC
# Defaulting to GOOGLE_API_KEY for simplest local development
GOOGLE_API_KEY=your_google_api_key
GEMINI_COPILOT_MODEL=gemini-3.1-pro-preview
GEMINI_CRITIC_MODEL=gemini-3.6-flash
GEMINI_HISTORIAN_MODEL=gemini-3.1-pro-preview
GEMINI_REPORTER_MODEL=gemini-3.6-flash
